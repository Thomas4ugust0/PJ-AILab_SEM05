FROM python:3.12-alpine

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install OS dependencies if needed (psycopg2 usually needs postgresql-dev, gcc, musl-dev in alpine)
# The user specified alpine, psycopg2-binary might work but often needs compilation or libpq
RUN apk add --no-cache libpq

COPY requirements.txt .
# Since we are using alpine, we might need build deps for psycopg2-binary.
# To keep it simple and small, we install them, pip install, and remove them.
RUN apk add --no-cache --virtual .build-deps \
    gcc \
    musl-dev \
    postgresql-dev \
    && pip install --no-cache-dir -r requirements.txt \
    && apk del .build-deps

COPY . .

# Create a non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000"]
